# ==========================================================================
# Per-challenge config. Edit this file for each new Mars challenge.
# Every script (and the Dockerfile build) reads its values from here.
# ==========================================================================

# --- Target repo (Choose a Repository step) ---
# Use an IMMUTABLE commit hash, never a branch or tag.
REPO_URL="https://github.com/tobymao/sqlglot.git"
COMMIT="REPLACE_WITH_FULL_40_CHAR_COMMIT_HASH"

# How to install the project + its test deps inside the image (build phase only).
# sqlglot: pip install -e ".[dev]"   |  rich: pip install -e ".[dev]"   |  pygments: pip install -e .
INSTALL_CMD='pip install -e ".[dev]"'

# --- Test selection (Write Deterministic Tests step) ---
# TEST_PATHS: pathspec(s) that contain ONLY your test changes. Used to split the
#   working tree into test.patch vs solution.patch. Space-separate if more than one.
TEST_PATHS="tests/test_mars_challenge.py"

# NEW_TESTS: what `./test.sh ... new` runs. Must FAIL on base, PASS after solution.
NEW_TESTS="tests/test_mars_challenge.py"

# BASE_TESTS: what `./test.sh ... base` runs as a regression check. Must always PASS.
#   Keep this fast: target the package's existing suite or a representative subset.
BASE_TESTS="tests/"

# Extra args passed to pytest in both modes (determinism guards live here).
PYTEST_ARGS="-p no:cacheprovider"

# Local image tag for self-review.
IMAGE="mars-challenge:local"
